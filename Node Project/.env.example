# Flowdesk — environment configuration
# Copy to .env and adjust. Every value below has a safe default.

# --- Server ---
PORT=4318
NODE_ENV=production

# Where the SQLite database and uploads are stored.
# Point this at a persistent volume in Docker, or a mounted disk on a VPS.
DATA_DIR=./server/data

# --- Branding defaults (a workspace can override these in Settings) ---
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_TIMEZONE=UTC

# --- Optional integrations (not required to run Flowdesk) ---
# Stripe — enables real card payments on the client portal.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# bKash — enables mobile payments for Bangladesh.
# BKHASH_APP_KEY=xxx
# BKHASH_APP_SECRET=xxx
# BKHASH_USERNAME=xxx
# BKHASH_PASSWORD=xxx

# SMTP — enables automatic invoice and reminder emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=xxx
# SMTP_PASS=xxx
# SMTP_FROM="Flowdesk <billing@yourdomain.com>"

# WhatsApp Business API — enables direct WhatsApp reminders.
# WHATSAPP_TOKEN=xxx
# WHATSAPP_PHONE_NUMBER_ID=xxx
