# Flowdesk — environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# Every value below is a placeholder: nothing here is a live credential.
#
#   cp "Node Project/.env.example" "Node Project/.env"
#
# The application runs with no .env file at all. Everything below is optional
# and only needed for the feature it sits next to.

# ---------------------------------------------------------------- server ---

# HTTP port the API listens on.
PORT=4318

# Set to "production" in production.
NODE_ENV=development

# Where the SQLite database file is stored.
# Point this at a persistent volume in Docker, or a mounted disk on a VPS.
DATA_DIR=./server/data

# Mark the session cookie as Secure. On by default when NODE_ENV=production.
# Set to "false" only when testing a production build over plain HTTP locally.
COOKIE_SECURE=false

# Set to "false" to disable the automatic demo seed on boot.
# Useful in production, where the database should start empty.
SEED_ON_BOOT=true

# ----------------------------------------------- optional: demo seeding ----

# Credentials for the demo workspace created by `npm run seed`.
# Leave blank to use the documented demo account.
DEMO_EMAIL=
DEMO_PASSWORD=

# ----------------------------------------- optional: Stripe card payments ---

# Enables real card payments on the client portal.
# STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ------------------------------------------- optional: bKash mobile money ---

# Enables bKash payments for Bangladesh.
# BKHASH_APP_KEY=YOUR_APP_KEY_HERE
# BKHASH_APP_SECRET=YOUR_APP_SECRET_HERE
# BKHASH_USERNAME=YOUR_USERNAME_HERE
# BKHASH_PASSWORD=YOUR_PASSWORD_HERE

# ---------------------------------------------- optional: automatic email ---

# Enables automatic invoice emails and payment reminders.
# SMTP_HOST=smtp.YOUR_MAIL_PROVIDER_HERE
# SMTP_PORT=587
# SMTP_USER=YOUR_SMTP_USERNAME_HERE
# SMTP_PASS=YOUR_SMTP_PASSWORD_HERE
# SMTP_FROM="Flowdesk <billing@YOUR_DOMAIN_HERE>"

# ------------------------------------- optional: WhatsApp Business API -----

# Enables direct WhatsApp payment reminders.
# WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN_HERE
# WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE
