{
  "name": "flowdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flowdesk — client, quote, invoice and cashflow workspace for small service businesses.",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "serve": "npm run build && npm run start",
    "deploy": "node scripts/deploy.js",
    "export:sql": "node scripts/export-sql.js",
    "package:release": "node scripts/package-release.js",
    "verify:release": "node scripts/verify-release.js",
    "verify:fresh": "node scripts/verify-fresh.js",
    "clean:test-users": "node scripts/clean-test-users.js",
    "capture": "node scripts/capture.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
